APP_ENV=production
APP_SECRET_KEY=replace-with-a-long-random-secret
APP_USERNAME=boat-operator
APP_PASSWORD_HASH=generate-with-python-app.py-hash-password

MQTT_HOST=your-broker-hostname
MQTT_PORT=8883
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
MQTT_TOPIC=esp32/sensors
MQTT_TLS=true

TELEMETRY_DB_PATH=instance/telemetry.sqlite3
TELEMETRY_MAX_ROWS=100000
RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/1
TRUST_PROXY=false